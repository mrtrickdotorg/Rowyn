[Desktop Entry]
Type=Application
Name=Installing software on Rowyn
Comment=Inspects a .deb and routes it: Flatpak first, or the guarded app-container install
Exec=/usr/bin/rowyn-deb-handler %f
Icon=system-software-install
Terminal=false
MimeType=application/vnd.debian.binary-package;
Categories=System;
NoDisplay=true
